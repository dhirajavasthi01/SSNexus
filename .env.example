# Optional. When empty, the contact form stays visible and reports that delivery is not connected.
VITE_CONTACT_ENDPOINT=

# Optional future documentation URL. The integration page stays a presentation until this is set.
VITE_DOCS_URL=

# Optional merchant portal. The header Login button appears only when this is set.
VITE_LOGIN_URL=

# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
VITE_SITE_URL=https://www.ssnexus.com

# Server-only UAE payment settings. Do not prefix these with VITE_.
# Leave them empty until the PayPal sandbox app and UAE acquirer contract exist.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
ACQUIRER_CHECKOUT_URL=
PUBLIC_SITE_URL=http://127.0.0.1:5173
